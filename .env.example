DISCORD_TOKEN=
DISCORD_GUILD_ID=
# Use the ID of your members role, not its name.
DISCORD_MEMBER_ROLE_ID=
CLOUDFLARE_ACCOUNT_ID=
# UUID of the cseed-membership database, not its display name.
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
D1_TABLE=People
D1_FIRST_NAME_COLUMN=first_name
D1_LAST_NAME_COLUMN=last_name
D1_UW_EMAIL_COLUMN=uw_email
D1_CS_EMAIL_COLUMN=cs_email
# Optional eligibility condition. Leave column empty to allow every record.
D1_STATUS_COLUMN=
D1_STATUS_VALUE=active
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
MESSAGE_FILE=messages/verification.txt
ERROR_MESSAGE_FILE=messages/error.txt
FAILURE_MESSAGE_FILE=messages/verification_failed.txt
STATE_DB=data/state.sqlite3
# Full scans every 15 minutes; joins and name changes still trigger checks immediately.
SCAN_INTERVAL_SECONDS=900
REMINDER_INTERVAL_HOURS=24
DM_COOLDOWN_SECONDS=60
MAX_CONCURRENT_API=2
# Shared cap for name checks and DM verification workflows per minute.
MAX_API_PER_MINUTE=60
# Docker runtime limits. CPU is measured in cores, not a percentage of the whole Pi.
BOT_CPUS=0.5
BOT_MEMORY_LIMIT=256m
